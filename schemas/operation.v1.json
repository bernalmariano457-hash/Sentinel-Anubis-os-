{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-anubis.dev/schemas/operation.v1.json",
  "title": "Forensic operation",
  "type": "object",
  "required": [
    "schema_version",
    "operation_id",
    "name",
    "operator_id",
    "started_at",
    "time_source",
    "time_uncertainty_ms",
    "jurisdiction",
    "legal_basis",
    "device"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "operation_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "operator_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": ["string", "null"], "format": "date-time" },
    "time_source": { "enum": ["gps", "ntp", "system"] },
    "time_uncertainty_ms": { "type": "integer", "minimum": 0 },
    "location": {
      "type": "object",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "alt_m": { "type": "number" },
        "source": { "type": "string" }
      }
    },
    "jurisdiction": { "type": "string", "minLength": 2 },
    "legal_basis": { "type": "string", "minLength": 1 },
    "device": {
      "type": "object",
      "required": ["model", "serial", "os_version"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "serial": { "type": "string" },
        "os_version": { "type": "string" }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}