{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-anubis.dev/schemas/operator.v1.json",
  "title": "Operator identity (public)",
  "type": "object",
  "required": [
    "schema_version",
    "operator_id",
    "display_name",
    "pubkey",
    "pubkey_fingerprint",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "operator_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "pubkey": {
      "type": "string",
      "description": "Base64-encoded Ed25519 raw public key (32 bytes).",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "pubkey_fingerprint": {
      "type": "string",
      "pattern": "^SHA256:[0-9a-f]{64}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "rotated_from": { "type": "string", "minLength": 1 },
    "revoked_at": { "type": "string", "format": "date-time" }
  }
}