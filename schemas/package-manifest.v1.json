{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-anubis.dev/schemas/package-manifest.v1.json",
  "title": "Package (.sae) manifest",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "operation_id",
    "created_at",
    "time_source",
    "time_uncertainty_ms",
    "operator_id",
    "artifacts",
    "custody_log_sha256",
    "custody_entries_count",
    "custody_head_hash",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "package_id": { "type": "string", "format": "uuid" },
    "operation_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "time_source": { "enum": ["gps", "ntp", "system"] },
    "time_uncertainty_ms": { "type": "integer", "minimum": 0 },
    "operator_id": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "type",
          "directory",
          "files",
          "manifest_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "artifact_id": { "type": "string", "format": "uuid" },
          "type": { "type": "string" },
          "directory": { "type": "string", "pattern": "^artifacts/.+/$" },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "sha256", "size_bytes"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "size_bytes": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "custody_log_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "custody_entries_count": { "type": "integer", "minimum": 0 },
    "custody_head_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timeline_sha256": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "report_sha256": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "value", "pubkey_fingerprint"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "value": { "type": "string", "minLength": 1 },
        "pubkey_fingerprint": {
          "type": "string",
          "pattern": "^SHA256:[0-9a-f]{64}$"
        }
      }
    }
  }
}